{
  "name": "WF-002 — Notificación por cambio de estado",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "citas/status-change", "responseMode": "responseNode", "options": {} },
      "id": "status-webhook",
      "name": "Evento desde citas-api",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": { "conditions": { "options": { "caseSensitive": true }, "conditions": [{ "leftValue": "={{ ['APPROVED','REJECTED','CANCELLED'].includes($json.body.status) }}", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }] } },
      "id": "valid-event",
      "name": "Validar evento",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [240, 0]
    },
    {
      "parameters": { "sendTo": "={{ $json.body.patientEmail }}", "subject": "Actualización de tu cita", "message": "=Tu cita cambió a estado: {{ $json.body.status }}.", "options": {} },
      "id": "status-email",
      "name": "Notificar por correo",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [480, -80],
      "credentials": { "gmailOAuth2": { "id": "REEMPLAZAR_EN_N8N", "name": "Gmail de laboratorio" } }
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={\"accepted\":true}", "options": {} },
      "id": "response-ok",
      "name": "Responder 202",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 0]
    }
  ],
  "connections": { "Evento desde citas-api": { "main": [[{ "node": "Validar evento", "type": "main", "index": 0 }]] }, "Validar evento": { "main": [[{ "node": "Notificar por correo", "type": "main", "index": 0 }], [{ "node": "Responder 202", "type": "main", "index": 0 }]] }, "Notificar por correo": { "main": [[{ "node": "Responder 202", "type": "main", "index": 0 }]] } },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "template-wf-002",
  "meta": { "template": true, "requires": ["Public webhook URL", "Gmail OAuth"] },
  "pinData": {}
}
